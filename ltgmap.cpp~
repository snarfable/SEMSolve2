#include <ltgmap.h>

void ltgmap_init( ltgmap_t *map_in, basis_t *basis_in, mesh_t *mesh_in, potential_t *pot_in )
{
	/* Copy pointers */
	map_in->basis = basis_in;
	map_in->mesh = mesh_in;
	map_in->potential = pot_in;

	/* Zero everything */
	map_in->map = NULL;
	map_in->plane = NULL;
	map_in->member = NULL;
	map_in->mbsize = NULL;
	map_in->psize = NULL;
	map_in->npmap = NULL;
	map_in->npsize = NULL;
	map_in->npeqvs = NULL;
	map_in->eqsize = NULL;
	map_in->bexcld = NULL;
	map_in->nbndry = NULL;
	map_in->nplane = 0;
	map_in->nnpmap = 0;
	map_in->nnpeqv = 0;
	map_in->nglobal = 0;
	map_in->bglobal = 0;

	/* Make sure dimensionality is consistent b/w basis and mesh */
	assert( map_in->basis->dim == map_in->mesh->dim );

	/* Call all the fancy functions */
	ltgmap_gen_planes_set( map_in );
	ltgmap_gen_local_node_plane_map( map_in );
	ltgmap_gen_local_plane_equivs( map_in );
	ltgmap_gen_ltgmap( map_in );
	ltgmap_detect_boundary( map_in );
	ltgmap_exclude_boundary( map_in );
}


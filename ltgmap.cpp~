void ltgmap_affine( ltgmap_t *map_in, long int simpx_in, double *local_in, double *global_out )
{
	long int i,j,dim = map_in->basis->dim,*simpx = map_in->mesh->simpx,v1,v2;
	double *vertx = map_in->mesh->vertx;

	for(i=0;i<dim;i++)
		global_out[i] = 0.0;

	for(i=0;i<dim;i++)
	{
		v2 = simpx[simpx_in*(dim+1)+i+1];
		v1 = simpx[simpx_in*(dim+1)+0];
		for(j=0;j<dim;j++)
			global_out[j] += local_in[i] * ( vertx[v2*dim+j] - vertx[v1*dim+j] );
	}

	/* Add the shift */
	v1 = simpx[simpx_in*(dim+1)+0];
	for(i=0;i<dim;i++)
		global_out[i] += vertx[v1*dim+i];
}

double ltgmap_simplex_volume( ltgmap_t *map_in, long int simpx_in )
{
	long int i,j,dim = map_in->basis->dim;
	double face[(dim+1)*dim];

	for(i=0;i<dim+1;i++)
	{
		for(j=0;j<dim;j++)
			face[i*dim+j] = map_in->mesh->vertx[map_in->mesh->simpx[simpx_in*(dim+1)+i]*dim+j];
	}
	return fabs( mesh_simplex_determ( dim, face + dim * dim, face ) ) / (double) factorial( dim );
}

double ltgmap_simplex_volume_signed( ltgmap_t *map_in, long int simpx_in )
{
	long int i,j,dim = map_in->basis->dim;
	double face[(dim+1)*dim];

	for(i=0;i<dim+1;i++)
	{
		for(j=0;j<dim;j++)
			face[i*dim+j] = map_in->mesh->vertx[map_in->mesh->simpx[simpx_in*(dim+1)+i]*dim+j];
	}
	return mesh_simplex_determ( dim, face + dim * dim, face ) / (double) factorial( dim );
}

double ltgmap_inner_prod( ltgmap_t *map_in, long int simpx_in, long int fidx1_in, long int fidx2_in )
{
	double prd = inner_prod( map_in->basis, fidx1_in, fidx2_in );
	return prd * ltgmap_simplex_volume( map_in, simpx_in );
}

double ltgmap_potential_inner_prod( ltgmap_t *map_in, long int simpx_in, long int fidx1_in, long int fidx2_in )
{
	long int i,j,dim = map_in->basis->dim,qpdim = map_in->basis->qpdim;
	double tot,db1,db2,ptl,gbl[dim],*qnodes = map_in->basis->qnodes,*qcoeffs = map_in->basis->qcoeffs;

	tot = 0.0;
	for(i=0;i<qpdim;i++)
	{
		db1 = basis_eval_interp_func( map_in->basis, fidx1_in, qnodes + i * dim );
		db2 = basis_eval_interp_func( map_in->basis, fidx2_in, qnodes + i * dim );
		ltgmap_affine( map_in, simpx_in, qnodes + i * dim, gbl );
		ptl = potential_energy( map_in->potential, gbl );
		tot += qcoeffs[i] * ptl * db1 * db2;
	}
	return tot * ltgmap_simplex_volume( map_in, simpx_in );
}

double ltgmap_kinetic_inner_prod( ltgmap_t *map_in, long int simpx_in, long int fidx1_in, long int fidx2_in )
{
	long int i,j,dim = map_in->basis->dim;
	double simp[(dim+1)*dim];

	for(i=0;i<dim+1;i++)
	{
		for(j=0;j<dim;j++)
			simp[i*dim+j] = map_in->mesh->vertx[map_in->mesh->simpx[simpx_in*(dim+1)+i]*dim+j];
	}

	double prd = kinetic_inner_prod( map_in->basis, fidx1_in, fidx2_in, simp );
	return prd * ltgmap_simplex_volume( map_in, simpx_in );
}

int ltgmap_gen_planes_set( ltgmap_t *map_in )
{
	long int dim = map_in->mesh->dim;
	long int i,j,k,m,n,len,max,ncmb,ofst;
	long int *fnd,*tmp,*iop = NULL,*isc = NULL;
	long int cmb[dim],dmb[dim];
	long int **ump;

	ncmb = 0;
	for(i=1;i<=dim;i++)
		ncmb += binomial( dim + 1, i );
	fnd = (long int*) malloc( ncmb * map_in->mesh->nsimp * sizeof(long int) );
	if( fnd == NULL )
		return -1;

	/* Initialize all to not found (0) */
	for(i=0;i<ncmb*map_in->mesh->nsimp;i++)
		fnd[i] = 0;

	for(i=0;i<map_in->mesh->nsimp;i++)
	{
		for(j=0;j<dim+1;j++)
		{
			if( j == 0 || map_in->mesh->nssize[map_in->mesh->simpx[i*(dim+1)+j]] > max )
				max = map_in->mesh->nssize[map_in->mesh->simpx[i*(dim+1)+j]];
		}
		tmp = (long int*) realloc( isc, max * sizeof(long int) );
		if( tmp == NULL )
			return -1;
		else
			isc = tmp;
		tmp = (long int*) realloc( iop, max * sizeof(long int) );
		if( tmp == NULL )
			return -1;
		else
			iop = tmp;

		/* For each size of combination up to dim */
		for(j=1,ofst=0;j<=dim;j++)
		{
			/* map_in->mesh->simpx[i*(dim+1)+cmb[0:dim]] */
			combinadic_init( dim + 1, j, cmb );
			for(k=0;k<binomial(dim+1,j);k++)
			{
				/* Check to see if already found */
				if( fnd[i*ncmb+ofst+k] == 1 )
				{
					combinadic_next( dim + 1, j, cmb );
					continue;
				}

				/* Copy the first set into isc */
				for(m=0;m<map_in->mesh->nssize[map_in->mesh->simpx[i*(dim+1)+cmb[0]]];m++)
					isc[m] = map_in->mesh->nsmap[map_in->mesh->simpx[i*(dim+1)+cmb[0]]][m];
				len = m;

				/* Take intersection of all nsmap[cmb[:]] */
				for(m=1;m<j;m++)
				{
					
					len = simple_set_intersect_long( len, isc,
									 map_in->mesh->nssize[map_in->mesh->simpx[i*(dim+1)+cmb[m]]],
									 map_in->mesh->nsmap[map_in->mesh->simpx[i*(dim+1)+cmb[m]]],
									 iop );
					for(n=0;n<len;n++)
						isc[n] = iop[n];
				}

				/* Now isc contains the set of simplices containing the face stored in cmb;
					now iterate through all simplices in isc and decide if it has been
					found yet or not, i.e. via fnd[] */
				for(m=0;m<len;m++)
				{
					/* isc[m] is the current simplex, so search all size j faces in simplex m */
					for(n=0;n<j;n++)
					{
						dmb[n] = simple_find_long( map_in->mesh->simpx[i*(dim+1)+cmb[n]],
									   dim + 1,
									   map_in->mesh->simpx + isc[m] * (dim+1) );
						if( dmb[n] < 0 || dmb[n] > dim )
							return -2;
					}
					bubble_sort_long( j, dmb );
					n = combinadic_index( j, dmb );
					fnd[isc[m]*ncmb+ofst+n] = 1; /* found it in simplex isc[m], combinadic ofst + n */
				}

				/* Now add the plane into the set of planes */
				++map_in->nplane;
				ump = (long int**) realloc( map_in->plane, map_in->nplane * sizeof(long int*) );
				if( ump == NULL )
					return -3;
				map_in->plane = ump;
				tmp = (long int*) malloc( j * sizeof(long int) );
				if( tmp == NULL )
					return -4;
				map_in->plane[map_in->nplane-1] = tmp;
				for(m=0;m<j;m++)
					map_in->plane[map_in->nplane-1][m] = map_in->mesh->simpx[i*(dim+1)+cmb[m]];
				tmp = (long int*) realloc( map_in->psize, map_in->nplane * sizeof(long int) );
				if( tmp == NULL )
					return -5;
				map_in->psize = tmp;
				map_in->psize[map_in->nplane-1] = j;

				/* Save the simplices which share the plane */
				ump = (long int**) realloc( map_in->member, map_in->nplane * sizeof(long int*) );
				if( ump == NULL )
					return -6;
				map_in->member = ump;
				tmp = (long int*) malloc( len * sizeof(long int) );
				if( tmp == NULL )
					return -7;
				map_in->member[map_in->nplane-1] = tmp;
				for(m=0;m<len;m++)
					map_in->member[map_in->nplane-1][m] = isc[m];
				tmp = (long int*) realloc( map_in->mbsize, map_in->nplane * sizeof(long int) );
				if( tmp == NULL )
					return -8;
				map_in->mbsize = tmp;
				map_in->mbsize[map_in->nplane-1] = len;

				combinadic_next( dim + 1, j, cmb );
			}
			ofst += k; /* Used as offset for storing into fnd[] */
		}
	}

	if( isc != NULL )
		free( isc );
	if( iop != NULL )
		free( iop );
	free( fnd );

	return 0;
}

/**
 * This function decides if each of the local interpolation
 * nodes lies in any of the planes of the standard simplex.
 */
int ltgmap_gen_local_node_plane_map( ltgmap_t *map_in )
{
	long int i,j,k,m,n,p,fnd,dim = map_in->basis->dim,deg = map_in->basis->deg,pdim = map_in->basis->pdim;
	long int cmb[dim];
	double tmp;

	/* Generate the standard vectors somehow; in the future, use the basis_t functions */
	double stdvec[dim*(dim+1)];
	for(i=0;i<dim;i++)
		stdvec[i] = 0.0;
	for(i=0;i<dim;i++)
	{
		for(j=0;j<dim;j++)
		{
			if(j!=i)
				stdvec[(i+1)*dim+j] = 0.0;
			else
				stdvec[(i+1)*dim+j] = 1.0;
		}
	}

	/* Allocate npmap and npsize */
	map_in->nnpmap = 0;

	/* There is a BETTER way to do this; i.e. one which doesn't involve a sum */
	for(i=1;i<=dim;i++)
		map_in->nnpmap += binomial( dim + 1, i );

	map_in->npmap = (long int**) malloc( map_in->nnpmap * sizeof(long int*) );
	for(i=0;i<map_in->nnpmap;i++)
		map_in->npmap[i] = NULL;
	map_in->npsize = (long int*) malloc( map_in->nnpmap * sizeof(long int) );
	for(i=0;i<map_in->nnpmap;i++)
		map_in->npsize[i] = 0;

	m = 0; /* This is the plane index */
	for(j=1;j<=dim;j++) /* For each plane size from 1 to dim */
	{
		combinadic_init( dim + 1, j, cmb );
		for(k=0;k<binomial(dim+1,j);k++) /* For each plane of size j */
		{
			for(i=0;i<pdim;i++)
			{
				/* Look in the plane for interpolation node i */
				tmp = basis_plane_test( dim, j, stdvec, cmb, map_in->basis->nodes + i * dim );
				if( fabs( tmp ) < LTGMAP_ZERO_THRESHOLD )
				{
					/* Then it's in the plane, so check to see if it's in a smaller plane already */
					fnd = 0;

					/* Checking all planes w/index less than the current one (m) */
					for(n=0;n<m;n++)
					{
						p = simple_find_long( i, map_in->npsize[n], map_in->npmap[n] );
						if( p != -1 )
						{
							fnd = 1;
							break;
						}
					}

					if( fnd == 0 )
					{
						++map_in->npsize[m];
						map_in->npmap[m] = (long int*) realloc( map_in->npmap[m], map_in->npsize[m] * sizeof(long int) );
						map_in->npmap[m][map_in->npsize[m]-1] = i;
					}
				}
			}
			combinadic_next( dim + 1, j, cmb );
			++m;
		}
	}
}

/**
 * This function fills in the data for npeqvs, i.e. the interfacial and automorphism maps.
 */
int ltgmap_gen_local_plane_equivs( ltgmap_t *map_in )
{
	long int g,i,j,k,m,n,p,q,r,s,t,oset,fct,bin,size,dim = map_in->basis->dim;
	long int cmb[dim],dmb[dim],pmb[dim],qmb[dim],**tmp,*ump;
	double *nodes = map_in->basis->nodes;
	double stdvec[dim*(dim+1)],smpmat[dim*(dim+1)],vec1[dim+1],vec2[dim+1],sum;

	/* Size including automorphisms */
	size = 0;
	for(i=1;i<=dim;i++)
		size += factorial( i ) * factorial( i ) * ( binomial( binomial( dim + 1, i ), 2l ) + binomial( dim + 1, i ) );

	/* Allocate room for map_in->npeqvs */
	tmp = (long int**) malloc( size * sizeof(long int*) );
	if( tmp == NULL )
		return -1;
	map_in->npeqvs = tmp;

	/* Initialize all allocated pointers in map_in->npeqvs to NULL (for realloc()) */
	for(i=0;i<size;i++)
		map_in->npeqvs[i] = NULL;

	/* Allocate room for map_in->eqsize */
	ump = (long int*) malloc( size * sizeof(long int) );
	if( ump == NULL )
		return -2;
	map_in->eqsize = ump;

	/* Initialize all entry sizes to 0 */
	for(i=0;i<size;i++)
		map_in->eqsize[i] = 0;

	/* Build the list of standard vectors */
	for(i=0;i<dim;i++)
		stdvec[i] = 0.0;
	for(i=0;i<dim;i++)
	{
		for(j=0;j<dim;j++)
		{
			if(j!=i)
				stdvec[(i+1)*dim+j] = 0.0;
			else
				stdvec[(i+1)*dim+j] = 1.0;
		}
	}

	/* Initialize the global index into map_in->npeqvs */
	g = 0;

	/* Initialize the plane size offset to zero */
	oset = 0;

	/* Start iteration by size */
	for(i=1;i<=dim;i++)
	{
		/* Stuf that doesn't change except with i */
		fct = factorial( i );
		bin = binomial( dim + 1, i );

		/* Start the shit */
		combinadic_init( dim + 1, i, cmb );
		for(j=0;j<bin;j++)
		{
			combinadic_init( dim + 1, i, dmb );
			for(k=0;k<j;k++)
			{
				for(m=0;m<fct;m++)
				{
					/* pmb will be overwritten after this step */
					factoradic_vector_long( m, i, pmb );

					/* Now make the actual permutation of cmb, put it in pmb */
					for(s=0;s<i;s++)
						pmb[s] = cmb[pmb[s]];

					for(n=0;n<fct;n++)
					{
						/* qmb will be overwritten after this step */
						r = factoradic_vector_long( n, i, qmb );

						/* Now make the actual permutation of dmb; put it in qmb */
						for(s=0;s<i;s++)
							qmb[s] = dmb[qmb[s]];

						/* Make sure return is 0 */
						if( r != 0 )
							return -3;

						/* Now make combinations of nodes in the planes oset + j and oset + k */
						for(p=0;p<map_in->npsize[oset+j];p++)
						{
							/* Make sure the "origin" or "central" node is listed last and next to its neighbors in cmb */
							for(s=0;s<i;s++)
								for(t=0;t<dim;t++)
									smpmat[(dim-s)*dim+t] = stdvec[pmb[s]*dim+t];

							/* Fill in the rest of the vectors after the plane vectors have been added in correct order */
							for(s=0,r=0;s<dim+1&&r<dim+1;s++)
							{
								if( simple_find_long( s, i, pmb ) == -1 )
								{
									for(t=0;t<dim;t++)
										smpmat[r*dim+t] = stdvec[s*dim+t];
									++r;
								}
							}

							/* Calculate the barycentric coordinates of node p in plane oset + j */
							basis_barycentric( dim, nodes + map_in->npmap[oset+j][p] * dim, smpmat, vec1 );

							/* Start second round for comparison */
							for(q=0;q<map_in->npsize[oset+k];q++)
							{
								for(s=0;s<i;s++)
									for(t=0;t<dim;t++)
										smpmat[(dim-s)*dim+t] = stdvec[qmb[s]*dim+t];
								for(s=0,r=0;s<dim+1&&r<dim+1;s++)
								{
									if( simple_find_long( s, i, qmb ) == -1 )
									{
										for(t=0;t<dim;t++)
											smpmat[r*dim+t] = stdvec[s*dim+t];
										++r;
									}
								}
								basis_barycentric( dim, nodes + map_in->npmap[oset+k][q] * dim, smpmat, vec2 );

								/* Now do the actual comparison between vec1 and vec2 */
								t = 0;
								for(s=0;s<dim+1;s++) // Vector is of dimension i - 1, not i
								{
									if( fabs( vec2[s] - vec1[s] ) > LTGMAP_ZERO_THRESHOLD )
									{
										t = 1;
										break;
									}
								}

								/* If t = 1, then not equal, else equal so add the entry */
								if( t == 0 )
								{
									/* Append the item to map_in->npeqvs[g][] */
									++map_in->eqsize[g];
									ump = (long int*) realloc( map_in->npeqvs[g], 2 * map_in->eqsize[g] * sizeof(long int) );
									if( ump == NULL )
										return -4;
									map_in->npeqvs[g] = ump;
									map_in->npeqvs[g][2*map_in->eqsize[g]-2] = map_in->npmap[oset+j][p]; // From plane j
									map_in->npeqvs[g][2*map_in->eqsize[g]-1] = map_in->npmap[oset+k][q]; // From plane k
								}
							}
						}

						/* Innermost step, g should sum up to size on termination */
						++g;
					}
				}
				combinadic_next( dim + 1, i, dmb );
			}
			combinadic_next( dim + 1, i, cmb );
		}

		/* Now do the automorphisms, appending to the end */
		combinadic_init( dim + 1, i, cmb );
		for(j=0;j<bin;j++)
		{
			/* Form two different factoradics of the same face, face j */
			for(k=0;k<fct;k++)
			{
				factoradic_vector_long( k, i, pmb );
				for(s=0;s<i;s++)
					pmb[s] = cmb[pmb[s]];
				for(m=0;m<fct;m++)
				{
					factoradic_vector_long( m, i, qmb );
					for(s=0;s<i;s++)
						qmb[s] = cmb[qmb[s]];
					for(p=0;p<map_in->npsize[oset+j];p++)
					{
						for(s=0;s<i;s++)
							for(t=0;t<dim;t++)
								smpmat[(dim-s)*dim+t] = stdvec[pmb[s]*dim+t];
						for(s=0,r=0;s<dim+1&&r<dim+1;s++)
						{
							if( simple_find_long( s, i, pmb ) == -1 )
							{
								for(t=0;t<dim;t++)
									smpmat[r*dim+t] = stdvec[s*dim+t];
								++r;
							}
						}
						basis_barycentric( dim, nodes + map_in->npmap[oset+j][p] * dim, smpmat, vec1 );

						/* No redundancy because comparing nodes in same plane */
						for(q=0;q<map_in->npsize[oset+j];q++)
						{
							for(s=0;s<i;s++)
								for(t=0;t<dim;t++)
									smpmat[(dim-s)*dim+t] = stdvec[qmb[s]*dim+t];
							for(s=0,r=0;s<dim+1&&r<dim+1;s++)
							{
								if( simple_find_long( s, i, qmb ) == -1 )
								{
									for(t=0;t<dim;t++)
										smpmat[r*dim+t] = stdvec[s*dim+t];
									++r;
								}
							}
							basis_barycentric( dim, nodes + map_in->npmap[oset+j][q] * dim, smpmat, vec2 );

							t = 0;
							for(s=0;s<dim+1;s++) // Vector is of dimension i - 1, not i
							{
								if( fabs( vec2[s] - vec1[s] ) > LTGMAP_ZERO_THRESHOLD )
								{
									t = 1;
									break;
								}
							}

							if( t == 0 )
							{
								/* Append the item to map_in->npeqvs[g][] */
								++map_in->eqsize[g];
								ump = (long int*) realloc( map_in->npeqvs[g], 2 * map_in->eqsize[g] * sizeof(long int) );
								if( ump == NULL )
									return -5;
								map_in->npeqvs[g] = ump;
								map_in->npeqvs[g][2*map_in->eqsize[g]-2] = map_in->npmap[oset+j][p];
								map_in->npeqvs[g][2*map_in->eqsize[g]-1] = map_in->npmap[oset+j][q];
							}
						}
					}
					++g;
				}
			}
			combinadic_next( dim + 1, i, cmb );
		}
		oset += binomial( dim + 1, i ); /* Take a step up in size to offset the plane combinadic index */
	}
}

/**
 * This function takes a pair of combinadic indices (specifying faces of dimension dim_in)
 * and a pair of permutations specified by factoradic indices for dim_in objects and outputs
 * the index of the corresponding entry in map_in->npeqvs and map_in->eqsize.
 */
long int ltgmap_face_pair_index( long int dim_in, long int size_in, long int cmb_1_in, long int cmb_2_in, long int fct_1_in, long int fct_2_in )
{
	long int i,bin,fct,last,cmb[2],idx = 0;

	/* Calculate the offset due to combination of size dim_in */
	for(i=1;i<size_in;i++)
	{
		bin = binomial( dim_in + 1, i );
		fct = factorial( i );
		idx += fct * fct * ( binomial( bin, 2l ) + bin );
	}

	/* Now calculate the index of the combinadic and factoradic of size dim_in */
	fct = factorial( size_in );
	if( cmb_1_in < cmb_2_in )
	{
		cmb[0] = cmb_1_in, cmb[1] = cmb_2_in;
		idx += combinadic_index( 2, cmb ) * fct * fct;
	}
	else
	{
		if( cmb_2_in < cmb_1_in )
		{
			cmb[0] = cmb_2_in, cmb[1] = cmb_1_in;
			idx += combinadic_index( 2, cmb ) * fct * fct;
		}
		else /* Otherwise they are equal, so these are at the END */
		{
			last = binomial( binomial( dim_in + 1, size_in ), 2l ) * fct * fct; /* Let this be the past-the-end index */
			idx += last + cmb_1_in * fct * fct; /* The same-face pairs are always after all of the legitimate combinations of size i */
		}
	}

	idx += fct_1_in * fct + fct_2_in;

	return idx;
}

/**
 * A very very important note with regard to the map_in->npeqvs array: If ltgmap_face_pair_index
 * is used to get an index into map_in->npeqvs/map_in->eqsize, it will return the same index
 * regardless of the order in which the combinadic indices are entered, so must compare cidx1
 * with cidx2, and if cidx1 \< cidx2, then the left entry in any equivalence pair in map_in->npeqvs[eqx],
 * where eqx is the index return by ltgmap_face_pair_index, is from face cidx2 and the right entry
 * of any pair is from cidx1, i.e. opposite the order which seems logical. Just remember that
 * ltgmap_gen_local_plane_equivs decides the order.
 */
int ltgmap_gen_ltgmap( ltgmap_t *map_in )
{
	long int i,j,k,m,n,p,coset,cidx1,cidx2,fidx1,fidx2,eqx,ngn,dim = map_in->basis->dim,pdim = map_in->basis->pdim;
	long int *tmp,cmb[dim],local[dim],locals[dim],localf[dim];

	tmp = (long int*) malloc( map_in->mesh->nsimp * map_in->basis->pdim * sizeof(long int) );
	if( tmp == NULL )
		return -1;
	map_in->map = tmp;
	for(i=0;i<map_in->mesh->nsimp*pdim;i++)
		map_in->map[i] = -1;

	/* The number of global nodes */
	ngn = 0;

	/* Iterate through each plane */
	for(i=0;i<map_in->nplane;i++)
	{
		/* Form the combinadic offset for size map_in->psize[i] */
		coset = 0;
		for(j=1;j<map_in->psize[i];j++)
			coset += binomial( dim + 1, j );

		/* Iterate through each simplex containing plane i */
		for(j=0;j<map_in->mbsize[i];j++)
		{
			/* Get the definition of plane i in simplex map_in->member[i][j] */
			if( ltgmap_simplex_local_indices( map_in, map_in->member[i][j], map_in->psize[i], map_in->plane[i], local ) == -1 )
				return -3;
			for(k=0;k<map_in->psize[i];k++)
				locals[k] = local[k];
			bubble_sort_long( map_in->psize[i], locals );
			for(k=0;k<map_in->psize[i];k++)
			{
				m = simple_find_long( locals[k], map_in->psize[i], local );
				if( m == -1 )
					return -4;
				localf[m] = k;
			}

			/* Now calculate factoradic index from localf */
			fidx1 = factoradic_index_long( map_in->psize[i], localf );
			cidx1 = combinadic_index( map_in->psize[i], locals );

			/* For each interpolation node in plane coset + cidx1 */
			for(p=0;p<map_in->npsize[coset+cidx1];p++)
			{
				/* Define the node */
				if( map_in->map[map_in->member[i][j]*pdim+map_in->npmap[coset+cidx1][p]] != -1 )
					continue;

				/* Define it */
				map_in->map[map_in->member[i][j]*pdim+map_in->npmap[coset+cidx1][p]] = ngn++;

				/* Now find ALL other definitions of node p in other simplices */
				for(k=j+1;k<map_in->mbsize[i];k++)
				{
					if( ltgmap_simplex_local_indices( map_in, map_in->member[i][k], map_in->psize[i], map_in->plane[i], local ) == -1 )
						return -5;
					for(m=0;m<map_in->psize[i];m++)
						locals[m] = local[m];
					bubble_sort_long( map_in->psize[i], locals );
					for(m=0;m<map_in->psize[i];m++)
					{
						n = simple_find_long( locals[m], map_in->psize[i], local );
						if( n == -1 )
							return -6;
						localf[n] = m;
					}
	
					fidx2 = factoradic_index_long( map_in->psize[i], localf );
					cidx2 = combinadic_index( map_in->psize[i], locals );
	
					/* Now calculate the entry in map_in->npeqvs */
					eqx = ltgmap_face_pair_index( dim, map_in->psize[i], cidx1, cidx2, fidx1, fidx2 );

					/* Now look through map_in->npeqvs[eqx] which is of length map_in->eqsize[eqx] for equivalencies */
					if( cidx1 < cidx2 )
					{
						for(n=0;n<map_in->eqsize[eqx];n++)
						{
							if( map_in->npeqvs[eqx][2*n+1] == map_in->npmap[coset+cidx1][p] )
							{
								map_in->map[map_in->member[i][k]*pdim+map_in->npeqvs[eqx][2*n+0]]
									= map_in->map[map_in->member[i][j]*pdim+map_in->npmap[coset+cidx1][p]];
								break;
							}
						}
					}
					else
					{
						for(n=0;n<map_in->eqsize[eqx];n++)
						{
							if( map_in->npeqvs[eqx][2*n+0] == map_in->npmap[coset+cidx1][p] )
							{
								map_in->map[map_in->member[i][k]*pdim+map_in->npeqvs[eqx][2*n+1]]
									= map_in->map[map_in->member[i][j]*pdim+map_in->npmap[coset+cidx1][p]];
								break;
							}
						}
					}
				}
			}
		}
	}

	for(i=0;i<map_in->mesh->nsimp;i++)
	{
		for(j=0;j<pdim;j++)
		{
			if( map_in->map[i*pdim+j] == -1 )
				map_in->map[i*pdim+j] = ngn++;
		}
	}

	/* Set the global number of nodes */
	map_in->nglobal = ngn;

	return 0;
}

/**
 * This function searches through all size dim surfaces which belong
 * to only a single simplex (i.e. they are on the outer hull by necessity),
 * and checks to see if the input node lies in any of them.
 * @param map_in The global map
 * @param point_in The Euclidean point of interest
 */
int ltgmap_boundary_check( ltgmap_t *map_in, double *point_in )
{
	long int i,j,k,dim = map_in->basis->dim,vids[dim];
	int fnd;
	double ret,sph,face[dim+1];

	for(i=0;i<map_in->nplane;i++)
	{
		if( map_in->psize[i] == dim && map_in->mbsize[i] == 1 )
		{
			/* Then map_in->plane[i] is on the boundary, so check point_in against it */
			for(j=0;j<dim;j++)
				vids[j] = map_in->plane[i][j];

			/* Copy the coordinates of the face into face */
			for(j=0;j<dim;j++)
				for(k=0;k<dim;k++)
					face[j*dim+k] = map_in->mesh->vertx[vids[j]*dim+k];

			ret = mesh_simplex_determ( dim, point_in, face );

			if( fabs( ret ) < LTGMAP_ZERO_THRESHOLD ) /* Then it's in the plane */
			{
				/* Now MUST check to see if point_in actually lies inside the member simplex */
				
// 				if( fabs( sph - 1.0 ) < LTGMAP_ZERO_THRESHOLD )
					return 1;
			}
		}
	}
	return 0;
}

int ltgmap_detect_boundary( ltgmap_t *map_in )
{
	long int i,j,k,dim = map_in->basis->dim,pdim = map_in->basis->pdim;
	double gnd[dim];
	char *ptr;

	ptr = (char*) malloc( map_in->basis->pdim * map_in->mesh->nsimp * sizeof(char) );
	if( ptr == NULL )
		return -1;
	map_in->nbndry = ptr;

	for(i=0;i<map_in->mesh->nsimp;i++)
	{
		for(j=0;j<map_in->basis->pdim;j++)
		{
			ltgmap_affine( map_in, i, map_in->basis->nodes + j * dim, gnd );
			if( ltgmap_boundary_check( map_in, gnd ) == 1 )
				map_in->nbndry[i*pdim+j] = (char) 1; /* This one is on the boundary */
			else
				map_in->nbndry[i*pdim+j] = (char) 0; /* This one isn't */
		}
	}

	return 0;
}

/**
 * This function requires some method for detecting whether a point lies on the
 * boundary of the system or not.
 */
int ltgmap_exclude_boundary( ltgmap_t *map_in )
{
	long int i,j,c,dim = map_in->basis->dim,pdim = map_in->basis->pdim,*tmp;

	tmp = (long int*) malloc( map_in->nglobal * sizeof(long int) );
	if( tmp == NULL )
		return -1;
	map_in->bexcld = tmp;
	for(i=0;i<map_in->nglobal;i++)
		map_in->bexcld[i] = -2;

	c = 0;
	for(i=0;i<map_in->mesh->nsimp;i++)
	{
		for(j=0;j<pdim;j++)
		{
			if( map_in->bexcld[map_in->map[i*pdim+j]] == -2 )
			{
				if( map_in->nbndry[i*pdim+j] == 0 )
					map_in->bexcld[map_in->map[i*pdim+j]] = c++; /* It's given an index */
				else
					map_in->bexcld[map_in->map[i*pdim+j]] = -1; /* This means it's excluded */
			}
		}
	}

	/* Store the number of nodes in the fixed-boundary case */
	map_in->bglobal = c;

	return 0;
}

/**
 * This function just returns basically the order in which the global vertex index numbers
 * appear in the set of nodes defining the simplex of interest.
 */
int ltgmap_simplex_local_indices( ltgmap_t *map_in, long int simpx_in, long int nnodes_in, long int *gnodes_in, long int *lnodes_out )
{
	long int i,dim = map_in->mesh->dim;

	/* Find node gnodes_in[i] in map_in->mesh->simpx[simpx_in] */
	for(i=0;i<nnodes_in;i++)
		lnodes_out[i] = simple_find_long( gnodes_in[i], map_in->mesh->dim + 1, map_in->mesh->simpx + simpx_in * (dim+1) );
	for(i=0;i<nnodes_in;i++)
		if( lnodes_out[i] == -1 )
			return -1;
	return 0;
}

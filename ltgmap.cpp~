	/* Call all the fancy functions */
	ltgmap_gen_planes_set( map_in );
}

void ltgmap_free( ltgmap_t *map_in )
{
	long int i;
	for(i=0;i<map_in->nplane;i++)
	{
		free( map_in->plane[i] );
		free( map_in->member[i] );
	}
	free( map_in->plane );
	free( map_in->member );
	for(i=0;i<map_in->nnpmap;i++)
		free( map_in->npmap[i] );
	free( map_in->npmap );
	free( map_in->npsize );
	for(i=0;i<map_in->nnpeqv;i++)
		free( map_in->npeqvs[i] );
	free( map_in->npeqvs );
	free( map_in->map );
	free( map_in->nbndry );
	free( map_in->bexcld );
}


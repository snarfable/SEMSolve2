void smatrix_eigen_solve( smatrix_t *mat_in )
{
	assert( mat_in->ncols == mat_in->nrows );
	long int i,j;
	double rots[mat_in->nrows];
	double tmp;
	long int rows[2*mat_in->nrows];
	long int nrot;
	for(i=0;i<SMATRIX_EIGENVALUE_MAX_ITS;i++)
	{
		/* Use the Rayleigh quotient shift */
		for(j=mat_in->nrows-1;j>0;j--)
		{
			smatrix_entry( mat_in, j, j - 1, &tmp );
			if( fabs( tmp ) > SMATRIX_ZERO_THRESHOLD )
				break;
		}
// 		smatrix_shift( mat_in, tmp );
		smatrix_dgvdlr( &nrot, rows, mat_in, rots );
		smatrix_dgvrotr( nrot, rows, mat_in, rots );
		smatrix_shift( mat_in, -1.0 * tmp );
		printf( "nrot = %d\n", nrot );
		if( nrot <= 0 )
			break;
	}
}

#include "slinalg.h"

/**
 * Matrix vector multiplication for sparse matrices.
 */

void smatrix_dgvrot( long int col_in, long int row1_in, long int row2_in, smatrix_t *A_in, double *omega_out )
{
	long int i,j,m,idx,jdx;
	double x,y,f,h,g,w;
	smatrix_entry( A_in, row1_in, col_in, &x );
	smatrix_entry( A_in, row2_in, col_in, &y );
	if( x != 0.0 && y != 0.0 ) /* x = 0 => entry non-existent by convention */
	{
		f = x / y;
		*omega_out = f;
		w = sqrt( 1.0 / ( 1.0 + f * f ) );
		g = -1.0 * f * w;
		f = g * x - w * y;
		h = w * x + g * y;
		smatrix_insert( A_in, row1_in, col_in, f );
		smatrix_delete( A_in, row2_in, col_in ); /* Need to fix this function first */
		for(i=0,j=0;i<A_in->lvec[row1_in]||j<A_in->lvec[row2_in];)
		{
			idx = A_in->jvec[row1_in][i]; // column in row1_in
			jdx = A_in->jvec[row2_in][j]; // column in row2_in
			if( idx == jdx && i < A_in->lvec[row1_in] && j < A_in->lvec[row2_in] ) // Both entries already exist
			{
				if( idx != col_in )
				{
					x = A_in->mvec[row1_in][i];
					y = A_in->mvec[row2_in][j];
					A_in->mvec[row1_in][i] = g * x - w * y;
					A_in->mvec[row2_in][j] = w * x + g * y;
				}
				++i,++j; // Increment both!!!
			}
			else
			{
				if( i < A_in->lvec[row1_in] && j < A_in->lvec[row2_in] )
				{
					if( idx < jdx ) // Only entry in row1_in exists
					{
						if( idx != col_in )
						{
							x = A_in->mvec[row1_in][i];
							A_in->mvec[row1_in][i] = g * x;
							h = w * x;
							smatrix_insert( A_in, row2_in, idx, h );
						}
						++i;
					}
					else // Only entry in row2_in exists
					{
						if( jdx != col_in )
						{
							y = A_in->mvec[row2_in][j];
							h = -1.0 * w * y;
							smatrix_insert( A_in, row1_in, jdx, h );
							A_in->mvec[row2_in][j] = g * y;
						}
						++j;
					}
				}
				else // One of the two indices is out of range
				{
					/* Check to see which is over the line */
					if( i < A_in->lvec[row1_in] && idx != col_in ) // Just j is over
					{
						/* Need to add entry to row2_in */
						x = A_in->mvec[row1_in][i];
						A_in->mvec[row1_in][i] = g * x;
						h = w * x;
						m = A_in->lvec[row2_in] - 1;
						_smatrix_insert( A_in, row2_in, idx, m, h );
						A_in->nvals = A_in->nvals + 1;
						++i,++j;
					}
					else
					{
						if( j < A_in->lvec[row2_in] && jdx != col_in ) // Just i is over
						{
							/* Need to add entry to row1_in */
							y = A_in->mvec[row2_in][j];
							A_in->mvec[row2_in][j] = g * y;
							h = -1.0 * w * y;
							m = A_in->lvec[row1_in] - 1; // Append it
							_smatrix_insert( A_in, row1_in, jdx, m, h );
							A_in->nvals = A_in->nvals + 1;
							++i,++j;
						}
						else // Both are over - just for idiot checking
						{
							// Better not fucking get here ever
							printf( "You should never see this message. This is a bug.\n" );
							break;
						}
					}
				}
			}
		}
	}
}

void _smatrix_dgvrotr( long int row1_in, long int row2_in, smatrix_t *A_in, double *omega_in )
{
	long int i,idx,jdx,its;
	double x,y,f,h,g,w;

	f = *omega_in;
	w = sqrt( 1.0 / ( 1.0 + f * f ) );
	g = -1.0 * f * w;
	for(i=0;i<A_in->nrows;i++)
	{
		/* Find columns row1_in and row2_in */
		if( A_in->lvec[i] <= 0 )
			continue;
		smatrix_entry( A_in, i, row1_in, &x );
		smatrix_entry( A_in, i, row2_in, &y );
		if( fabs(x) < SMATRIX_ZERO_THRESHOLD && fabs(y) < SMATRIX_ZERO_THRESHOLD )
			continue;
		f = x * g - y * w; // column row1_in insertion/update
		h = x * w + y * g; // column row2_in insertion/update
		if( fabs(f) > SMATRIX_ZERO_THRESHOLD )
			smatrix_insert( A_in, i, row1_in, f );
		else
			smatrix_delete( A_in, i, row1_in );
		if( fabs(h) > SMATRIX_ZERO_THRESHOLD )
			smatrix_insert( A_in, i, row2_in, h );
		else
			smatrix_delete( A_in, i, row2_in );
	}
}

void smatrix_dgvdlr( long int *num_out, long int *rows_out, smatrix_t *mat_in, double *rots_out )
{
	long int i,j;
	double tmp;
	j = 0;
	for(i=0;i<mat_in->ncols-1&&i<mat_in->nrows;i++)
	{
		smatrix_entry( mat_in, i+1, i, &tmp );
		if( fabs(tmp) > SMATRIX_ZERO_THRESHOLD )
		{
			smatrix_dgvrot( i, i, i+1, mat_in, &rots_out[j] );
			rows_out[2*j] = i;
			rows_out[2*j+1] = i+1;
			++j;
		}
	}
	*num_out = j;
}

void smatrix_dgvrotr( long int num_in, long int *rows_in, smatrix_t *A_in, double *rot_in )
{
	long int i;
	for(i=0;i<num_in;i++)
		_smatrix_dgvrotr( rows_in[2*i], rows_in[2*i+1], A_in, rot_in + i );
}

void smatrix_dgvtrn( long int col_in, long int row1_in, long int row2_in, smatrix_t *mat_in, double *param_out )
{
	smatrix_dgvrot( col_in, row1_in, row2_in, mat_in, param_out );
	_smatrix_dgvrotr( row1_in, row2_in, mat_in, param_out );
}

void smatrix_dgvhrd( smatrix_t *mat_in )
{
	long int i,j;
	double tmp,rot,params_out;
	assert( mat_in->nrows == mat_in->ncols );
	for(i=0;i<mat_in->ncols-1;i++)
	{
		for(j=mat_in->nrows-2;j>i;j--)
		{
			smatrix_entry( mat_in, j, i, &tmp );
			if( fabs( tmp ) > 0.0 )
				smatrix_dgvtrn( i, j, j+1, mat_in, &params_out );
		}
	}
}

void smatrix_darkrd_dense( int n_in, smatrix_t *A_in, dvector_t *b_in, dmatrix_t *Q_in, dmatrix_t *H_in )
{
	int i,j,k;
	double sum,tmp;
	dvector_t vec,wec,xec;

	/* Copy b_in into first column of Q_in */
	sum = 0.0;
	for(i=0;i<b_in->length;i++)
	{
		Q_in->start[Q_in->rsize*i] = b_in->start[i];
		sum += b_in->start[i] * b_in->start[i];
	}
	sum = sqrt( sum );
	for(i=0;i<b_in->length;i++)
		Q_in->start[Q_in->rsize*i] /= sum;

	/* Subtract one from n_in to make basis of correct size */
	--n_in;

	/* Outer loop - Matrix-vector multiplication in Q */
	vec.start = Q_in->start;
	vec.rsize = Q_in->rsize;
	vec.length = Q_in->nrows;
	wec.start = Q_in->start + 1;
	wec.rsize = Q_in->rsize;
	wec.length = Q_in->nrows;
	xec.rsize = Q_in->rsize;
	xec.length = Q_in->nrows;
	for(i=0;i<n_in;i++,vec.start++,wec.start++)
	{
		smatrix_dspmv( A_in, &vec, &wec );
		xec.start = Q_in->start;
		for(j=0;j<=i;j++,xec.start++)
		{
			tmp = dvector_dotp( &wec, &xec );
			for(k=0;k<xec.length;k++)
				wec.start[wec.rsize*k] = wec.start[wec.rsize*k] - tmp * xec.start[xec.rsize*k];
			H_in->start[i+H_in->rsize*j] = tmp;
		}
		sum = 0.0;
		for(k=0;k<wec.length;k++)
			sum += wec.start[wec.rsize*k] * wec.start[wec.rsize*k];
		sum = sqrt( sum );
		H_in->start[i+H_in->rsize*j] = sum;
		for(k=0;k<wec.length;k++)
			wec.start[wec.rsize*k] = wec.start[wec.rsize*k] / sum;
	}

	/* Create final column in H */
	smatrix_dspmv( A_in, &vec, b_in );
	xec.start = Q_in->start;
	for(i=0;i<=n_in;i++,xec.start++)
	{
		tmp = dvector_dotp( b_in, &xec );
		H_in->start[n_in+H_in->rsize*i] = tmp;
	}
}

void smatrix_darkrd_sparse( int n_in, smatrix_t *A_in, dvector_t *b_in, smatrix_t *Q_in, smatrix_t *H_in )
{
	int i,j,k;
	double sum,tmp;

	/* Copy b_in into first column of Q_in */
	sum = 0.0;
	for(i=0;i<b_in->length;i++)
		sum += b_in->start[i] * b_in->start[i];
	sum = sqrt( sum );
	for(i=0;i<b_in->length;i++)
		smatrix_insert( Q_in, i, 0, b_in->start[i] / sum );

	/* Subtract one from n_in to make basis of correct size */
	--n_in;

	/* Outer loop - Matrix-vector multiplication in Q */
	for(i=0;i<n_in;i++)
	{
		smatrix_dspmv_sparse( A_in, Q_in, i, Q_in, i + 1 );
		for(j=0;j<=i;j++)
		{
			tmp = smatrix_col_dot_prod( Q_in, j, Q_in, i + 1 );
			smatrix_lin_com( -1.0 * tmp, Q_in, j, 1.0, Q_in, i + 1, Q_in, i + 1 );
			smatrix_insert( H_in, j, i, tmp );
		}
		sum = smatrix_col_dot_prod( Q_in, i + 1, Q_in, i + 1 );
		sum = sqrt( sum );
		smatrix_insert( H_in, j, i, sum );
		for(k=0;k<Q_in->nrows;k++)
		{
			smatrix_entry( Q_in, k, i + 1, &tmp );
			smatrix_insert( Q_in, k, i + 1, tmp / sum );
		}
	}

	/* Create final column in H */
	smatrix_dspmv_sparse_dvector( A_in, Q_in, n_in, b_in );
	for(i=0;i<=n_in;i++)
	{
		tmp = smatrix_col_dot_prod_dvector( Q_in, i, b_in );
		smatrix_insert( H_in, i, n_in, tmp );
	}
}


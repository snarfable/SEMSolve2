/**
 * This is a slightly modified version of the Yale Sparse Matrix Format.
 * The typical Yale format would, in the place of double **mvec, have
 * a double *A type and an additional array, int *IA, which stores the index into
 * A at which row i would begin. For example, A[IA[i]] is the first non-zero entry in
 * row i of the matrix stored in A. Instead of this, I have used a double pointer
 * to represent variable-length rows in a matrix. It is equivalent to if not better
 * than using the additional IA vector because it takes a tiny amount of pointer
 * arithmetic out of the act of dereferencing a value in the matrix. The double
 * *lvec variable is such that lvec[i] is the number of non-zero entries in row
 * i of the matrix.
 * \param nvals Stores the number of non-zero entries in the matrix
 * \param nrows The number of rows
 * \param ncols The number of columns
 * \param mvec Stores the actual non-zero entries; mvec[i][j] is the value
 * 		of row i, column jvec[i][j]
 * \param jvec jvec[i][j] is the column of the value stored at mvec[i][j]
 * \param lvec lvec[i] is the number of non-zero entries in row i
 */
typedef struct
{
	long int	nvals;		///< Stores the number of non-zero entries in the matrix
	long int	nrows;		///< The number of rows
	long int	ncols;		///< The number of columns
	double		**mvec;		///< Stores the actual non-zero entries
	long int	**jvec;		///< jvec[i][j] is the column of the value stored at mvec[i][j]
	long int	*lvec;		///< lvec[i] is the number of non-zero entries in row i
} smatrix_t;


#ifndef SEMSOLVE2_DLINALG_H
#define SEMSOLVE2_DLINALG_H

#include <cassert>
#include <cstdio>
#include <cstdlib>
#include <cmath>

typedef struct
{
	double	*start;
	long int rsize;
	long int length;
} dvector_t;

typedef struct
{
	double	*start;
	long int rsize;
	long int nrows;
	long int ncols;
} dmatrix_t;

#include <dlinalg_asm.h>

/* Vector Utility Functions */
void	dvector_init( dvector_t *, long int );
void	dvector_free( dvector_t * );
int	dvector_load( dvector_t *, char * );
int	dvector_save( dvector_t *, char * );

/* General Vector functions */
double	dvector_dotp( dvector_t *, dvector_t * );

/* Matrix Utility Functions */
void	dmatrix_init( dmatrix_t *, long int, long int );
void	dmatrix_free( dmatrix_t * );
int	dmatrix_load( dmatrix_t *, char * );
int	dmatrix_save( dmatrix_t *, char * );
void	dmatrix_print( dmatrix_t * );

/* Linear and Decomposition Functions */
void	dmatrix_pivot( dmatrix_t *mat_in, int * );			///< Outputs permutation of rows s.t. no zeroes on diagonal
void	dmatrix_lu_dcmp( dmatrix_t * );					///< LU decomposition, overwriting
void	dmatrix_lu_dcmp_bl( dmatrix_t *, long int );			///< Block LU decomposition, overwriting
void	dmatrix_fb_sub_vrhs( dmatrix_t *, dvector_t * );		///< Forward and backward substitution, RHS is dvector_t
void	dmatrix_fb_sub_mrhs( dmatrix_t *, dmatrix_t * );		///< Forward and backward substitution, RHS is dmatrix_t
void	dmatrix_chol_dcmp( dmatrix_t * );				///< Cholesky decomposition, overwriting

/* Dense eigensystem functions */
void	dmatrix_uhess( dmatrix_t * );
void	dmatrix_givens( dmatrix_t *, long int, long int, long int );
void	dmatrix_givens_rhs( dmatrix_t * );
void	dmatrix_hhref( dmatrix_t * );

#endif

void smatrix_shift( smatrix_t *mat_in, double shift_in )
{
	long int i,j;
	double tmp;
	j = ( mat_in->nrows < mat_in->ncols ) ? mat_in->nrows : mat_in->ncols;
	for(i=0;i<j;i++)
	{
		smatrix_entry( mat_in, i, i, &tmp );
		smatrix_insert( mat_in, i, i, tmp - shift_in );
	}
}
